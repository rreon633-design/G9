{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G9",
  "version": "0.1.0",
  "identifier": "app.g9.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "G9",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#f3f3f5",
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; connect-src ipc: http://ipc.localhost http: https: ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Entertainment",
    "shortDescription": "Files, streams, live TV. One player.",
    "longDescription": "G9 is a desktop media player for local files and live streams you supply. It ships no channels or playlists. Windows 10/11 64-bit.",
    "copyright": "Copyright G9 contributors",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
