{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G9",
  "version": "0.11.0",
  "identifier": "app.g9.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "G9",
        "width": 1400,
        "height": 820,
        "minWidth": 960,
        "minHeight": 580,
        "backgroundColor": "#070b12",
        "center": true,
        "decorations": false,
        "transparent": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' blob:; font-src 'self'; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:; connect-src ipc: http://ipc.localhost http: https: ws: wss: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Entertainment",
    "shortDescription": "Files, streams, live TV. One player.",
    "longDescription": "G9 is a desktop media player for local files and live streams you supply. It ships no channels or playlists. Windows 10/11 64-bit.",
    "copyright": "Copyright G9 contributors",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "m4v",
          "mov",
          "avi",
          "ts",
          "m2ts",
          "mpg",
          "mpeg",
          "wmv",
          "flv"
        ],
        "name": "G9.Video",
        "description": "Video file",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus",
          "wma"
        ],
        "name": "G9.Audio",
        "description": "Audio file",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "G9.Playlist",
        "description": "Playlist",
        "mimeType": "audio/x-mpegurl",
        "role": "Viewer"
      }
    ]
  }
}
